# Public canonical URL (safe to expose; used for canonical links, sitemap, OG).
NEXT_PUBLIC_SITE_URL=https://aiformeaning.com

# Optional cloud Witness-Companion. Server-side only — never prefix these with NEXT_PUBLIC_.
# "local" (default) uses the deterministic offline LocalReflectionProvider.
# "openai-compatible" enables the constrained cloud adapter (requires the three values below).
MIRROR_COMPANION_PROVIDER=local
MIRROR_COMPANION_API_KEY=
MIRROR_COMPANION_BASE_URL=
MIRROR_COMPANION_MODEL=

# Deployment metadata (injected at build time by CI; shown by /api/health).
APP_VERSION=
GIT_COMMIT=

# Optional: help resource shown on /ground (defaults to findahelpline.com).
HELP_RESOURCE_URL=
HELP_RESOURCE_LABEL=
